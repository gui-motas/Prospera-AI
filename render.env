# Variáveis de ambiente para deploy no Render (TEMPLATE – SEM SEGREDOS).
# Cadastre os valores reais no painel "Environment" do serviço.

SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST>:<PORTA>/<BANCO>
DB_USERNAME=<USUARIO>
DB_PASSWORD=<SENHA>

APP_FRONTEND_URL=https://<SEU-FRONTEND>.onrender.com
APP_CORS_ALLOWED_ORIGINS=https://<SEU-FRONTEND>.onrender.com
# Frontend e backend em domínios diferentes: o cookie de sessão precisa ser SameSite=None e Secure
APP_COOKIE_SAMESITE=none
APP_COOKIE_SECURE=true

ADMIN_EMAIL=<EMAIL-DO-ADMINISTRADOR>
ADMIN_PASSWORD=<SENHA-DO-ADMINISTRADOR>

IA_PROVEDOR=anthropic
IA_CHAVE_API=<CHAVE-DA-API-DE-IA>
IA_MODELO=

# Frontend (build): URL pública do backend, já que no Render eles ficam em origens diferentes
# VITE_API_URL=https://<SEU-BACKEND>.onrender.com
