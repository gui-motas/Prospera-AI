# Variáveis de ambiente para deploy no Render (TEMPLATE – SEM SEGREDOS).
# Cadastre os valores reais no painel "Environment" do serviço.

SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST>:<PORTA>/<BANCO>
DB_USERNAME=<USUARIO>
DB_PASSWORD=<SENHA>

APP_FRONTEND_URL=https://<SEU-FRONTEND>.onrender.com

# O frontend deve ser servido na MESMA origem da API (ex.: Nginx do frontend
# encaminhando /api para o backend, como no compose.yaml). Assim o cookie de
# sessão fica SameSite=Lax e o CSRF continua bloqueado pelo navegador.
#
# Frontend e API em domínios diferentes exigem SameSite=None, o que remove a
# proteção do cookie contra requisições de outros sites. O CSRF está desligado
# no backend, então essa configuração só é segura porque o filtro de CORS
# aceita apenas as origens exatas abaixo — nunca use "*".
APP_CORS_ALLOWED_ORIGINS=https://<SEU-FRONTEND>.onrender.com

# Deixe os dois comentados se frontend e API estiverem na mesma origem.
# APP_COOKIE_SAMESITE=none
# APP_COOKIE_SECURE=true

ADMIN_EMAIL=<EMAIL-DO-ADMINISTRADOR>
ADMIN_PASSWORD=<SENHA-DO-ADMINISTRADOR>

IA_PROVEDOR=anthropic
IA_CHAVE_API=<CHAVE-DA-API-DE-IA>
IA_MODELO=

# Frontend (build): URL pública do backend, já que no Render eles ficam em origens diferentes
# VITE_API_URL=https://<SEU-BACKEND>.onrender.com
