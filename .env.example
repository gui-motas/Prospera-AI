# Copie para .env e ajuste. NUNCA versione o arquivo .env com segredos reais.

# Banco de dados
DB_USERNAME=postgres
DB_PASSWORD=postgres

# URLs
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Administrador inicial (opcional). Senha: mínimo 8 caracteres, com letras e números.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# API de Inteligência Artificial (RF-010). Sem chave, o planejamento inteligente
# aparece como indisponível e o restante da plataforma funciona normalmente (RNF-09).
#
# Anthropic (Claude):
#   IA_PROVEDOR=anthropic
#   IA_CHAVE_API=<sua chave>
#   IA_MODELO=            (vazio = modelo padrão definido em ConfiguracaoIA)
#
# Qualquer API compatível com o formato da OpenAI (OpenAI, Google Gemini, Groq, OpenRouter, Ollama…):
#   IA_PROVEDOR=openai
#   IA_CHAVE_API=<sua chave>
#   IA_MODELO=<nome do modelo>
#   IA_URL_BASE=<URL base, ex.: https://api.openai.com/v1>
IA_PROVEDOR=anthropic
IA_CHAVE_API=
IA_MODELO=
IA_URL_BASE=
IA_TIMEOUT_SEGUNDOS=30

# Confirmação de cadastro por e-mail (opcional). Se true, configure o SMTP abaixo;
# sem SMTP, o link de confirmação é exibido no log do backend.
APP_CONFIRMACAO_EMAIL=false
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=
